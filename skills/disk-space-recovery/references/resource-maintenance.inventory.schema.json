{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource-maintenance.inventory.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "docRoot", "targets"],
  "properties": {
    "schemaVersion": {"const": "resource-maintenance.inventory.v1"},
    "environment": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "docRoot": {"type": "string", "minLength": 1},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}}
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "platform", "transport", "expectedIdentity", "authoritativeDocs", "scanRoots", "protectedPaths", "thresholds", "operatorCapability"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "platform": {"enum": ["linux", "windows", "proxmox", "container"]},
        "transport": {"enum": ["local", "ssh-posix", "ssh-powershell", "proxmox-pct"]},
        "expectedIdentity": {"type": "string", "minLength": 1},
        "availability": {"enum": ["documented", "live-required", "unavailable"]},
        "parent": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.@:-]+$"},
        "containerId": {"type": "integer", "minimum": 0, "maximum": 999999},
        "authoritativeDocs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
        "scanRoots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "protectedPaths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "thresholds": {
          "type": "object", "additionalProperties": false,
          "required": ["diskFreePercent", "memoryAvailablePercent"],
          "properties": {
            "diskFreePercent": {"type": "number", "minimum": 0, "maximum": 100},
            "inodeFreePercent": {"type": "number", "minimum": 0, "maximum": 100},
            "memoryAvailablePercent": {"type": "number", "minimum": 0, "maximum": 100},
            "swapUsedPercent": {"type": "number", "minimum": 0, "maximum": 100},
            "pagefileUsedPercent": {"type": "number", "minimum": 0, "maximum": 100},
            "growthBytesPerHour": {"type": "integer", "minimum": 0}
          }
        },
        "operatorCapability": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "procedureRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "recoveryRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "discoverChildren": {"type": "boolean"},
        "gpuMonitoring": {"type": "boolean"}
      },
      "document": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "remoteOnly"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "remoteOnly": {"type": "boolean"}
        }
      }
    }
  }
}
