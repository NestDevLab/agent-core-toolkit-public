{
  "schemaVersion": 3,
  "name": "nestdev-core-toolkit",
  "version": "0.4.0",
  "requires": {
    "self-improve": {
      "source": "github:eai-org/agent-toolkit",
      "ref": "main",
      "select": ["skills/self-improve"]
    }
  },
  "compositionRules": [
    {
      "target": "skills/*",
      "include": "fragments/skill-evolution.md",
      "exclude": ["nestdev-core-toolkit:skills/skill-evolution"]
    }
  ],
  "suggests": {
    "brainstorming": {
      "source": "vercel:skills.sh/jwynia/agent-skills",
      "select": ["skills/brainstorming"],
      "reason": "Generate candidate angles before narrowing to an answer or opinion.",
      "when": "Use before convergence when the option space is still too narrow or underspecified."
    },
    "good-thinking": {
      "source": "vercel:skills.sh/jwynia/agent-skills",
      "select": ["skills/good-thinking"],
      "reason": "Audit reasoning quality before presenting a high-confidence answer.",
      "when": "Use when confidence is important but evidence, assumptions, or tradeoffs need another pass."
    },
    "grill-me": {
      "source": "skillkit:github:mattpocock/skills",
      "select": ["skills/grill-me"],
      "reason": "Stress-test a plan, design, or opinion before finalizing it.",
      "when": "Use when the user asks to challenge the conclusion or when the stakes justify adversarial review."
    }
  },
  "provides": [
    { "type": "instructions", "path": "AGENTS.md" },
    { "type": "fragments", "path": "fragments" },
    { "type": "rules", "path": "rules", "runtimes": ["claude", "copilot", "openclaw", "hermes"] },
    {
      "type": "skills",
      "path": "skills",
      "items": {
        "decision-interview": {
          "suggests": ["brainstorming", "good-thinking", "grill-me"]
        }
      }
    },
    {
      "type": "hooks",
      "path": "hooks/codex-suggested-next-message.json",
      "runtimes": ["codex"]
    },
    {
      "type": "hooks",
      "path": "hooks/skill-evolution-codex.json",
      "runtimes": ["codex"]
    },
    {
      "type": "hooks",
      "path": "hooks/skill-evolution-claude.json",
      "runtimes": ["claude"]
    },
    {
      "type": "hooks",
      "path": "hooks/copilot",
      "runtimes": ["copilot"]
    }
  ]
}
